{
  "openapi": "3.0.3",
  "info": {
    "title": "OrbitPlay API (PROVISIONAL contract)",
    "version": "0.0.0-provisional",
    "description": "Hand-authored placeholder contract covering only the endpoints listed in the setup brief. NOT aligned with the real API yet — replace with the API repo's openapi.json (via `pnpm gen:api <url|path>`) as soon as it exists. See DECISIONS.md."
  },
  "servers": [{ "url": "/api" }],
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Authenticate and start a session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session established",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "refresh",
        "summary": "Exchange the refresh cookie for a fresh access token",
        "responses": {
          "200": {
            "description": "New access token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RefreshResponse" }
              }
            }
          },
          "401": { "description": "Refresh failed" }
        }
      }
    },
    "/games": {
      "get": {
        "operationId": "listGames",
        "summary": "List games",
        "responses": {
          "200": {
            "description": "Games",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Game" }
                }
              }
            }
          }
        }
      }
    },
    "/games/{id}": {
      "get": {
        "operationId": "getGame",
        "summary": "Get a game by id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Game",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Game" } }
            }
          },
          "404": { "description": "Not found" }
        }
      }
    },
    "/test-models": {
      "get": {
        "operationId": "listTestModels",
        "summary": "List reusable test models",
        "responses": {
          "200": {
            "description": "Test models",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/TestModel" }
                }
              }
            }
          }
        }
      }
    },
    "/opportunities": {
      "get": {
        "operationId": "listOpportunities",
        "summary": "List opportunities for the current user",
        "responses": {
          "200": {
            "description": "Opportunities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Opportunity" }
                }
              }
            }
          }
        }
      }
    },
    "/tests/{id}/report": {
      "get": {
        "operationId": "getTestReport",
        "summary": "Get the report for a test run",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Report",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/TestReport" } }
            }
          },
          "404": { "description": "Not found" }
        }
      }
    },
    "/wallet": {
      "get": {
        "operationId": "getWallet",
        "summary": "Get the current player's wallet balance",
        "responses": {
          "200": {
            "description": "Wallet",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Wallet" } }
            }
          }
        }
      }
    },
    "/player/profile-stats": {
      "get": {
        "operationId": "getPlayerProfileStats",
        "summary": "Get the current player's profile stats (level, feedback quality, achievements, hours played)",
        "responses": {
          "200": {
            "description": "Player profile stats",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/PlayerStats" } }
            }
          }
        }
      }
    },
    "/tests/continue": {
      "get": {
        "operationId": "getContinueTest",
        "summary": "Get the in-progress test the player was last working on, if any",
        "responses": {
          "200": {
            "description": "Continue test, or null when there is none in progress",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [{ "$ref": "#/components/schemas/ContinueTest" }],
                  "nullable": true
                }
              }
            }
          }
        }
      }
    },
    "/tests/mine": {
      "get": {
        "operationId": "listMyTests",
        "summary": "List the current player's tests with progress",
        "responses": {
          "200": {
            "description": "My tests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/MyTestProgress" }
                }
              }
            }
          }
        }
      }
    },
    "/games/highlighted": {
      "get": {
        "operationId": "listHighlightedGames",
        "summary": "List games highlighted for the current player",
        "responses": {
          "200": {
            "description": "Highlighted games",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/HighlightedGame" }
                }
              }
            }
          }
        }
      }
    },
    "/earnings/summary": {
      "get": {
        "operationId": "getEarningsSummary",
        "summary": "Get the current player's earnings summary",
        "responses": {
          "200": {
            "description": "Earnings summary",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EarningsSummary" }
              }
            }
          }
        }
      }
    },
    "/missions/ranking": {
      "get": {
        "operationId": "getMissionsRanking",
        "summary": "Get the current player's missions and ranking overview",
        "responses": {
          "200": {
            "description": "Missions and ranking",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MissionsRanking" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Role": {
        "type": "string",
        "enum": ["studio", "player"],
        "description": "Authoritative role, decided by the backend (RN-03). The login tab does NOT set it."
      },
      "User": {
        "type": "object",
        "required": ["id", "name", "email", "role"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "role": { "$ref": "#/components/schemas/Role" },
          "avatarUrl": { "type": "string", "nullable": true }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" },
          "remember": { "type": "boolean", "default": false }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["user", "accessToken"],
        "properties": {
          "user": { "$ref": "#/components/schemas/User" },
          "accessToken": { "type": "string" }
        }
      },
      "RefreshResponse": {
        "type": "object",
        "required": ["accessToken"],
        "properties": {
          "accessToken": { "type": "string" }
        }
      },
      "Game": {
        "type": "object",
        "required": ["id", "title", "status", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["draft", "in_review", "published"]
          },
          "coverUrl": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "TestModel": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true }
        }
      },
      "Opportunity": {
        "type": "object",
        "required": ["id", "title", "reward", "status"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "gameId": { "type": "string", "nullable": true },
          "reward": { "type": "number" },
          "status": {
            "type": "string",
            "enum": ["open", "in_progress", "closed"]
          }
        }
      },
      "TestReport": {
        "type": "object",
        "required": ["id", "testId", "summary"],
        "properties": {
          "id": { "type": "string" },
          "testId": { "type": "string" },
          "summary": { "type": "string" },
          "score": { "type": "number", "nullable": true },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "content"],
              "properties": {
                "title": { "type": "string" },
                "content": { "type": "string" }
              }
            }
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      },
      "Wallet": {
        "type": "object",
        "required": ["balance"],
        "properties": {
          "balance": { "type": "number" }
        }
      },
      "PlayerTier": {
        "type": "string",
        "enum": ["bronze", "silver", "gold", "elite"]
      },
      "PlayerStats": {
        "type": "object",
        "required": ["tier", "level", "feedbackQuality", "achievements", "hoursPlayed"],
        "properties": {
          "tier": { "$ref": "#/components/schemas/PlayerTier" },
          "level": { "type": "number" },
          "feedbackQuality": { "type": "number" },
          "achievements": { "type": "number" },
          "hoursPlayed": { "type": "number" }
        }
      },
      "TestTrackProgress": {
        "type": "object",
        "required": ["label", "progress", "reward"],
        "properties": {
          "label": { "type": "string" },
          "progress": { "type": "number", "description": "0-100" },
          "reward": { "type": "number" }
        }
      },
      "ContinueTest": {
        "type": "object",
        "required": ["gameId", "gameTitle", "coverUrl", "playersCount", "endsAt", "tracks"],
        "properties": {
          "gameId": { "type": "string" },
          "gameTitle": { "type": "string" },
          "coverUrl": { "type": "string", "nullable": true },
          "playersCount": { "type": "number" },
          "endsAt": { "type": "string", "format": "date-time" },
          "tracks": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TestTrackProgress" }
          }
        }
      },
      "HighlightedGame": {
        "type": "object",
        "required": [
          "id",
          "title",
          "coverUrl",
          "status",
          "isNew",
          "playersCount",
          "endsAt",
          "openTests",
          "maxReward",
          "remainingReward"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "coverUrl": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["available", "unavailable"] },
          "isNew": { "type": "boolean" },
          "playersCount": { "type": "number" },
          "endsAt": { "type": "string", "format": "date-time" },
          "openTests": { "type": "number" },
          "maxReward": { "type": "number" },
          "remainingReward": { "type": "number" }
        }
      },
      "EarningsPoint": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "number" }
        }
      },
      "EarningsSummary": {
        "type": "object",
        "required": ["last7Days", "totalAccumulated", "nextPayoutInDays", "series"],
        "properties": {
          "last7Days": { "type": "number" },
          "totalAccumulated": { "type": "number" },
          "nextPayoutInDays": { "type": "number" },
          "series": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/EarningsPoint" }
          }
        }
      },
      "RankingCategory": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "number" }
        }
      },
      "MissionsRanking": {
        "type": "object",
        "required": ["rank", "rankDelta", "pending", "nextGoal", "categories"],
        "properties": {
          "rank": { "type": "number" },
          "rankDelta": { "type": "number" },
          "pending": { "type": "number" },
          "nextGoal": { "type": "number" },
          "categories": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RankingCategory" }
          }
        }
      },
      "MyTestProgress": {
        "type": "object",
        "required": ["id", "title", "progress", "reward", "action"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "progress": { "type": "number", "description": "0-100" },
          "reward": { "type": "number" },
          "action": { "type": "string", "enum": ["start", "continue", "complete"] }
        }
      }
    }
  }
}
