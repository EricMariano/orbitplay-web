{
  "openapi": "3.0.3",
  "info": {
    "title": "OrbitPlay API (PROVISIONAL contract)",
    "version": "0.0.0-provisional",
    "description": "Hand-authored placeholder contract covering only the endpoints listed in the setup brief. NOT aligned with the real API yet — replace with the API repo's openapi.json (via `pnpm gen:api <url|path>`) as soon as it exists. See DECISIONS.md."
  },
  "servers": [{ "url": "http://localhost:3000" }],
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Authenticate and start a session",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session established",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "refresh",
        "summary": "Exchange the refresh cookie for a fresh access token",
        "responses": {
          "200": {
            "description": "Session rotated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "401": { "description": "Refresh failed" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "End the current session",
        "responses": {
          "200": {
            "description": "Session ended and refresh cookie cleared",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "getCurrentUser",
        "summary": "Get the authenticated user",
        "responses": {
          "200": {
            "description": "Authenticated user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthUser" }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/auth/password/forgot": {
      "post": {
        "operationId": "forgotPassword",
        "summary": "Request a password reset",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ForgotPasswordRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generic response regardless of account existence",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        }
      }
    },
    "/games": {
      "get": {
        "operationId": "listGames",
        "summary": "List games",
        "responses": {
          "200": {
            "description": "Games",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Game" }
                }
              }
            }
          }
        }
      }
    },
    "/games/{id}": {
      "get": {
        "operationId": "getGame",
        "summary": "Get a game by id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Game",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Game" } }
            }
          },
          "404": { "description": "Not found" }
        }
      }
    },
    "/test-models": {
      "get": {
        "operationId": "listTestModels",
        "summary": "List reusable test models",
        "responses": {
          "200": {
            "description": "Test models",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/TestModel" }
                }
              }
            }
          }
        }
      }
    },
    "/opportunities": {
      "get": {
        "operationId": "listOpportunities",
        "summary": "List opportunities for the current user",
        "responses": {
          "200": {
            "description": "Opportunities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Opportunity" }
                }
              }
            }
          }
        }
      }
    },
    "/tests/{id}/report": {
      "get": {
        "operationId": "getTestReport",
        "summary": "Get the report for a test run",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Report",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/TestReport" } }
            }
          },
          "404": { "description": "Not found" }
        }
      }
    },
    "/wallet": {
      "get": {
        "operationId": "getWallet",
        "summary": "Get the current player's wallet balance",
        "responses": {
          "200": {
            "description": "Wallet",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Wallet" } }
            }
          }
        }
      }
    },
    "/player/profile-stats": {
      "get": {
        "operationId": "getPlayerProfileStats",
        "summary": "Get the current player's profile stats (level, feedback quality, achievements, hours played)",
        "responses": {
          "200": {
            "description": "Player profile stats",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/PlayerStats" } }
            }
          }
        }
      }
    },
    "/tests/continue": {
      "get": {
        "operationId": "getContinueTest",
        "summary": "Get the in-progress test the player was last working on, if any",
        "responses": {
          "200": {
            "description": "Continue test, or null when there is none in progress",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [{ "$ref": "#/components/schemas/ContinueTest" }],
                  "nullable": true
                }
              }
            }
          }
        }
      }
    },
    "/tests/mine": {
      "get": {
        "operationId": "listMyTests",
        "summary": "List the current player's tests with progress",
        "responses": {
          "200": {
            "description": "My tests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/MyTestProgress" }
                }
              }
            }
          }
        }
      }
    },
    "/games/highlighted": {
      "get": {
        "operationId": "listHighlightedGames",
        "summary": "List games highlighted for the current player",
        "responses": {
          "200": {
            "description": "Highlighted games",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/HighlightedGame" }
                }
              }
            }
          }
        }
      }
    },
    "/earnings/summary": {
      "get": {
        "operationId": "getEarningsSummary",
        "summary": "Get the current player's earnings summary",
        "responses": {
          "200": {
            "description": "Earnings summary",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EarningsSummary" }
              }
            }
          }
        }
      }
    },
    "/missions/ranking": {
      "get": {
        "operationId": "getMissionsRanking",
        "summary": "Get the current player's missions and ranking overview",
        "responses": {
          "200": {
            "description": "Missions and ranking",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MissionsRanking" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Role": {
        "type": "string",
        "enum": ["owner", "admin", "studio", "player"],
        "description": "Authoritative role, decided by the backend (RN-03). The login tab does NOT set it."
      },
      "AuthUser": {
        "type": "object",
        "required": ["userId", "email", "displayName", "organizationId", "role"],
        "properties": {
          "userId": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "displayName": { "type": "string" },
          "organizationId": { "type": "string", "format": "uuid" },
          "role": { "$ref": "#/components/schemas/Role" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["identifier", "password"],
        "properties": {
          "identifier": { "type": "string", "description": "E-mail or access ID" },
          "password": { "type": "string", "format": "password", "minLength": 8 },
          "rememberMe": {
            "type": "boolean",
            "default": false,
            "description": "Changes only the refresh-token TTL"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["accessToken", "expiresIn", "user"],
        "properties": {
          "accessToken": { "type": "string" },
          "expiresIn": { "type": "integer" },
          "user": { "$ref": "#/components/schemas/AuthUser" }
        }
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": { "type": "string", "format": "email" }
        }
      },
      "MessageResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string" }
        }
      },
      "Game": {
        "type": "object",
        "required": ["id", "title", "status", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["draft", "in_review", "published"]
          },
          "coverUrl": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "TestModel": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true }
        }
      },
      "Opportunity": {
        "type": "object",
        "required": ["id", "title", "reward", "status"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "gameId": { "type": "string", "nullable": true },
          "reward": { "type": "number" },
          "status": {
            "type": "string",
            "enum": ["open", "in_progress", "closed"]
          }
        }
      },
      "TestReport": {
        "type": "object",
        "required": ["id", "testId", "summary"],
        "properties": {
          "id": { "type": "string" },
          "testId": { "type": "string" },
          "summary": { "type": "string" },
          "score": { "type": "number", "nullable": true },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "content"],
              "properties": {
                "title": { "type": "string" },
                "content": { "type": "string" }
              }
            }
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_ERROR",
          "UNAUTHORIZED",
          "FORBIDDEN",
          "NOT_FOUND",
          "CONFLICT",
          "TOO_MANY_REQUESTS",
          "UNPROCESSABLE_ENTITY",
          "INTERNAL_ERROR"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["statusCode", "code", "message", "requestId"],
        "properties": {
          "statusCode": { "type": "integer" },
          "code": { "$ref": "#/components/schemas/ErrorCode" },
          "message": { "type": "string" },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "requestId": { "type": "string" }
        }
      },
      "Wallet": {
        "type": "object",
        "required": ["balance"],
        "properties": {
          "balance": { "type": "number" }
        }
      },
      "PlayerTier": {
        "type": "string",
        "enum": ["bronze", "silver", "gold", "elite"]
      },
      "PlayerStats": {
        "type": "object",
        "required": ["tier", "level", "feedbackQuality", "achievements", "hoursPlayed"],
        "properties": {
          "tier": { "$ref": "#/components/schemas/PlayerTier" },
          "level": { "type": "number" },
          "feedbackQuality": { "type": "number" },
          "achievements": { "type": "number" },
          "hoursPlayed": { "type": "number" }
        }
      },
      "TestTrackProgress": {
        "type": "object",
        "required": ["label", "progress", "reward"],
        "properties": {
          "label": { "type": "string" },
          "progress": { "type": "number", "description": "0-100" },
          "reward": { "type": "number" }
        }
      },
      "ContinueTest": {
        "type": "object",
        "required": ["gameId", "gameTitle", "coverUrl", "playersCount", "endsAt", "tracks"],
        "properties": {
          "gameId": { "type": "string" },
          "gameTitle": { "type": "string" },
          "coverUrl": { "type": "string", "nullable": true },
          "playersCount": { "type": "number" },
          "endsAt": { "type": "string", "format": "date-time" },
          "tracks": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TestTrackProgress" }
          }
        }
      },
      "HighlightedGame": {
        "type": "object",
        "required": [
          "id",
          "title",
          "coverUrl",
          "status",
          "isNew",
          "playersCount",
          "endsAt",
          "openTests",
          "maxReward",
          "remainingReward"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "coverUrl": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["available", "unavailable"] },
          "isNew": { "type": "boolean" },
          "playersCount": { "type": "number" },
          "endsAt": { "type": "string", "format": "date-time" },
          "openTests": { "type": "number" },
          "maxReward": { "type": "number" },
          "remainingReward": { "type": "number" }
        }
      },
      "EarningsPoint": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "number" }
        }
      },
      "EarningsSummary": {
        "type": "object",
        "required": ["last7Days", "totalAccumulated", "nextPayoutInDays", "series"],
        "properties": {
          "last7Days": { "type": "number" },
          "totalAccumulated": { "type": "number" },
          "nextPayoutInDays": { "type": "number" },
          "series": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/EarningsPoint" }
          }
        }
      },
      "RankingCategory": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "number" }
        }
      },
      "MissionsRanking": {
        "type": "object",
        "required": ["rank", "rankDelta", "pending", "nextGoal", "categories"],
        "properties": {
          "rank": { "type": "number" },
          "rankDelta": { "type": "number" },
          "pending": { "type": "number" },
          "nextGoal": { "type": "number" },
          "categories": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RankingCategory" }
          }
        }
      },
      "MyTestProgress": {
        "type": "object",
        "required": ["id", "title", "progress", "reward", "action"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "progress": { "type": "number", "description": "0-100" },
          "reward": { "type": "number" },
          "action": { "type": "string", "enum": ["start", "continue", "complete"] }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token"
      }
    }
  }
}
