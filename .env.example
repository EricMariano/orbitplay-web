# Base URL the API client prefixes onto every request.
# In dev this stays relative so Vite proxies /api -> http://localhost:3000
# (same-origin, so the httpOnly session cookie is sent). See vite.config.ts.
VITE_API_URL=/api

# Links de download do app desktop. Em produção, sem link a plataforma não aparece
# no menu; use os nomes fixos publicados pelo workflow `desktop-release`, ex.:
#   https://github.com/<org>/orbitplay-web/releases/latest/download/OrbitPlay-Setup.exe
# Em dev pode ficar vazio: usa /downloads/<arquivo> servido pelo Vite a partir de release/.
VITE_DESKTOP_DOWNLOAD_WIN=
VITE_DESKTOP_DOWNLOAD_MAC=
VITE_DESKTOP_DOWNLOAD_LINUX=
