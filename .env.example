# Base URL the API client prefixes onto every request.
# In dev this stays relative so Vite proxies /api -> http://localhost:3000
# (same-origin, so the httpOnly session cookie is sent). See vite.config.ts.
VITE_API_URL=/api

# Links de download do app desktop (opcional; sem link, o item de menu fica oculto).
# Ex.: URL do instalador publicado no GitHub Releases.
VITE_DESKTOP_DOWNLOAD_WIN=
VITE_DESKTOP_DOWNLOAD_MAC=
VITE_DESKTOP_DOWNLOAD_LINUX=
